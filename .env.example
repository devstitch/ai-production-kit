# Server-side only. Never expose these to the browser or commit real values.

# OpenAI API key used by OpenAIAdapter.
OPENAI_API_KEY=

# Anthropic API key used by AnthropicAdapter.
ANTHROPIC_API_KEY=

# Optional Postgres connection string for PostgresUsageStore.
# The demo uses an in-memory store when this is unset.
DATABASE_URL=

# Optional OTLP HTTP endpoint. Leave unset to keep the console exporter only.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set to true to force the primary provider to fail so fallback can be demonstrated.
SIMULATE_PRIMARY_FAILURE=

# Optional overrides for the live provider test script. Not used by pnpm test.
OPENAI_LIVE_MODEL=
ANTHROPIC_LIVE_MODEL=
