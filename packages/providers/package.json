{
  "name": "@devstitch/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --experimental-strip-types --test test/normalize-usage.test.ts test/validate-output.test.ts",
    "test:live": "tsc -p tsconfig.json && node --experimental-strip-types --test test/live/structured-output.live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@devstitch/core": "workspace:*",
    "ai": "^7.0.126",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3"
  }
}
